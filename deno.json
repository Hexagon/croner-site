{
  "tasks": {
    "build": "deno run --allow-read --allow-write --allow-env scripts/build.ts",
    "serve": "deno run --allow-read --allow-write --allow-env --allow-net --watch=src/,scripts/ scripts/build.ts --serve",
    "sync": "deno run --allow-read --allow-write scripts/sync.ts"
  },
  "imports": {
    "@std/front-matter": "jsr:@std/front-matter@^1",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/http": "jsr:@std/http@^1",
    "@std/path": "jsr:@std/path@^1",
    "highlight.js": "npm:highlight.js@^11",
    "markdown-it": "npm:markdown-it@^14"
  },
  "fmt": { "lineWidth": 120 }
}
